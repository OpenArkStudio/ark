cmake_minimum_required(VERSION 3.20)
foreach(argument BIN_DIR RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
if(NOT DEFINED HOST)
    set(HOST "127.0.0.1")
endif()
if(NOT DEFINED PORT)
    set(PORT 19100)
endif()
if(NOT HOST MATCHES "^[a-zA-Z0-9.:_-]+$" OR NOT PORT MATCHES "^[0-9]+$" OR PORT LESS 1 OR PORT GREATER 65535)
    message(FATAL_ERROR "HOST must be a literal/hostname; PORT must be 1..65535")
endif()
set(endpoint_host "${HOST}")
if(HOST MATCHES ":")
    set(endpoint_host "[${HOST}]")
endif()
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_filename_component(binary_root "${BIN_DIR}" ABSOLUTE)
get_filename_component(runtime_root "${RUNTIME_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${runtime_root}/bin" "${runtime_root}/conf")
file(COPY "${binary_root}/" DESTINATION "${runtime_root}/bin")
file(COPY "${source_root}/config/guest_room.app.toml" "${source_root}/config/kernel.plugin.conf"
    DESTINATION "${runtime_root}/conf")
file(READ "${source_root}/config/guest_room.bus.toml" bus)
string(REPLACE "127.0.0.1:19100" "${endpoint_host}:${PORT}" bus "${bus}")
file(WRITE "${runtime_root}/conf/guest_room.bus.toml" "${bus}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/resource/" DESTINATION "${runtime_root}/resource")
message(STATUS "guest_room staged at ${runtime_root}; tcp://${endpoint_host}:${PORT}")
