@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

set(ark_AVAILABLE_COMPONENTS "@ark_package_components@")
foreach(component IN LISTS ark_AVAILABLE_COMPONENTS)
    set(ark_${component}_FOUND TRUE)
endforeach()
# A config-only consumer must not acquire networking/runtime dependencies.
set(_ark_need_core TRUE)
if(ark_FIND_COMPONENTS)
    set(_ark_need_core FALSE)
    foreach(component IN LISTS ark_FIND_COMPONENTS)
        if(NOT component MATCHES "^(config|config_headers|kernel_json)$")
            set(_ark_need_core TRUE)
        endif()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/arkConfigHeaderTargets.cmake")
if(_ark_need_core)
    find_dependency(arknet 0.2.3 CONFIG)
    # Keep the installed dependency's feature contract compatible with this build.
    if(NOT "${ARKNET_USE_BOOST_ASIO}" STREQUAL "@ARKNET_USE_BOOST_ASIO@" OR
       NOT "${ARKNET_ENABLE_SSL}" STREQUAL "@ARKNET_ENABLE_SSL@")
        set(ark_FOUND FALSE)
        set(ark_NOT_FOUND_MESSAGE "arknet Asio/SSL options must match the installed ark build")
        return()
    endif()
    find_dependency(spdlog 1.17 CONFIG)
    find_dependency(readerwriterqueue CONFIG)
    set(_ark_saved_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(RapidXML MODULE)
    set(CMAKE_MODULE_PATH "${_ark_saved_module_path}")
    if(@ARK_PACKAGE_HAS_PROTO@)
        find_dependency(Protobuf 3.0)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/arkTargets.cmake")
endif()
if(@ARK_PACKAGE_HAS_CONFIG@ AND (NOT ark_FIND_COMPONENTS OR "config" IN_LIST ark_FIND_COMPONENTS))
    if(@ARK_PACKAGE_NEEDS_TOML@)
        find_dependency(tomlplusplus 3.4 CONFIG)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/arkConfigReaderTargets.cmake")
endif()
if(@ARK_PACKAGE_HAS_KERNEL_JSON@ AND (NOT ark_FIND_COMPONENTS OR "kernel_json" IN_LIST ark_FIND_COMPONENTS))
    include("${CMAKE_CURRENT_LIST_DIR}/arkKernelJsonTargets.cmake")
endif()
check_required_components(ark)
unset(_ark_need_core)
unset(_ark_saved_module_path)
