cmake_minimum_required(VERSION 3.20)
foreach(argument PROGRAM PLUGIN_DIR SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
file(TO_CMAKE_PATH "${PLUGIN_DIR}" plugin_directory)

foreach(mode IN ITEMS
    drain drain_deadline drain_max_deadline drain_admission
    pre_shut_false shut_false shut_throw ready_throw ready_throw_unknown
    timeout_task timeout_native timeout_stalled update_throw update_throw_unknown
    stop_accepting_false stop_accepting_throw stop_accepting_throw_unknown)
    set(directory "${RUNTIME_DIR}/${mode}")
    file(MAKE_DIRECTORY "${directory}")
    file(REMOVE "${directory}/business-runtime.trace")
    file(WRITE "${directory}/exit.txt" "exit\n")
    file(WRITE "${directory}/application.toml"
        "[application]\nplugin_library_dir = '${plugin_directory}/'\nplugin_config_dir = './'\n"
        "[[plugins]]\nname = 'ark_business_runtime_probe'\nconfig = '${mode}'\n")
    set(deadline_argument)
    if(mode MATCHES "^timeout_")
        set(deadline_argument --shutdown_timeout_ms=50)
    elseif(mode STREQUAL "drain_max_deadline")
        set(deadline_argument --shutdown_timeout_ms=9223372036854775807)
    elseif(mode STREQUAL "drain_deadline")
        set(deadline_argument --shutdown_timeout_ms=2000)
    endif()
    if(mode MATCHES "^drain")
        set(timeout 15)
    else()
        # An owned failing child must remain alive. This is a test observation
        # bound, not a framework shutdown timeout or a successful stop result.
        set(timeout 5)
    endif()
    execute_process(
        COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=business-runtime-test
            "--app_conf=${directory}/application.toml"
            "--log_conf=${SOURCE_ROOT}/config/log.conf" ${deadline_argument}
        WORKING_DIRECTORY "${directory}"
        INPUT_FILE "${directory}/exit.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${timeout})
    file(WRITE "${directory}/output.log" "${output}\n${errors}")
    file(WRITE "${directory}/result.txt" "${result}\n")
    if(NOT EXISTS "${directory}/business-runtime.trace")
        message(FATAL_ERROR "${mode}: real test plugin did not run: ${result}\n${output}\n${errors}")
    endif()
    file(STRINGS "${directory}/business-runtime.trace" events)
    set(previous -1)
    if(mode STREQUAL "timeout_native")
        set(expected_events native-pending)
        if("start-1" IN_LIST events OR "complete-begin" IN_LIST events)
            message(FATAL_ERROR "${mode}: native-readiness case must not wait for managed tasks: ${events}")
        endif()
    else()
        set(expected_events start-1)
    endif()
    list(APPEND expected_events stop-accepting hook-root-rejected external-root-rejected admission-stop-pending)
    if(NOT mode MATCHES "^stop_accepting_")
        list(APPEND expected_events root-rejected)
    endif()
    if(mode STREQUAL "timeout_native")
        list(APPEND expected_events owner-stop native-exit)
    endif()
    if(mode MATCHES "^update_throw")
        list(APPEND expected_events update-throw update-resumed)
    endif()
    if(NOT mode STREQUAL "timeout_stalled" AND NOT mode STREQUAL "timeout_native" AND NOT mode MATCHES "^stop_accepting_")
        list(APPEND expected_events reply-1 received-1 start-2 reply-2 received-2)
        if(mode STREQUAL "drain_admission")
            list(APPEND expected_events start-3 reply-3 received-3)
        endif()
        list(APPEND expected_events complete-begin callback-stop-pending complete-end owner-stop native-exit)
    endif()
    if(mode MATCHES "^drain" OR mode MATCHES "^(pre_shut_false|shut_false|shut_throw)$")
        list(APPEND expected_events native-joined pre-shut)
    endif()
    foreach(event IN LISTS expected_events)
        list(FIND events "${event}" current)
        if(current LESS_EQUAL previous)
            message(FATAL_ERROR "${mode}: missing/out-of-order ${event}: ${events}\n${output}\n${errors}")
        endif()
        set(occurrences "${events}")
        list(FILTER occurrences INCLUDE REGEX "^${event}$")
        list(LENGTH occurrences count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "${mode}: ${event} must occur exactly once: ${events}")
        endif()
        set(previous ${current})
    endforeach()
    if(mode MATCHES "^ready_throw")
        set(throws "${events}")
        list(FILTER throws INCLUDE REGEX "^ready-throw$")
        list(LENGTH throws count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "${mode}: readiness must throw once and remain failed: ${events}")
        endif()
        if("pre-shut" IN_LIST events OR "shut" IN_LIST events OR "native-joined" IN_LIST events)
            message(FATAL_ERROR "${mode}: readiness failure entered teardown: ${events}")
        endif()
    endif()
    if(mode MATCHES "^stop_accepting_")
        foreach(forbidden root-rejected reply-1 received-1 complete-begin owner-stop native-joined pre-shut shut)
            if("${forbidden}" IN_LIST events)
                message(FATAL_ERROR "${mode}: failed admission advanced to ${forbidden}: ${events}")
            endif()
        endforeach()
    endif()
    if("cancel" IN_LIST events OR "task-error" IN_LIST events OR "unexpected-root" IN_LIST events)
        message(FATAL_ERROR "${mode}: accepted task was cancelled or failed: ${events}")
    endif()
    if(mode MATCHES "^drain")
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "Normal drain must exit 0, got ${result}\n${output}\n${errors}")
        endif()
        if("${output}\n${errors}" MATCHES "Shutdown (failed at |wait timed out |update failed)")
            message(FATAL_ERROR "${mode}: successful drain reported a shutdown failure")
        endif()
        foreach(event shut uninstall destroy)
            list(FIND events "${event}" current)
            if(current LESS_EQUAL previous)
                message(FATAL_ERROR "Normal drain teardown is out of order: ${events}")
            endif()
            set(previous ${current})
        endforeach()
        message(STATUS "${mode}: accepted task, callback retirement and native thread join precede unload, exit 0")
    else()
        if(NOT "${result}" MATCHES "[Tt]imeout")
            message(FATAL_ERROR "${mode}: expected retained process until test timeout, got ${result}")
        endif()
        if("uninstall" IN_LIST events OR "destroy" IN_LIST events)
            message(FATAL_ERROR "${mode}: failure incorrectly unloaded/destroyed its module: ${events}")
        endif()
        if((mode MATCHES "^timeout_" OR mode MATCHES "^update_throw") AND ("pre-shut" IN_LIST events OR "shut" IN_LIST events OR "native-joined" IN_LIST events))
            message(FATAL_ERROR "${mode}: retained launcher resumed shutdown after its failure: ${events}")
        endif()
        if(mode MATCHES "^timeout_")
            if(mode STREQUAL "timeout_native")
                set(pending 0)
                set(phase ready_to_shut)
            else()
                set(pending 1)
                set(phase managed_tasks)
            endif()
            string(REGEX MATCH "Shutdown wait timed out after ([0-9]+) ms" timed_out "${output}\n${errors}")
            if(NOT timed_out OR CMAKE_MATCH_1 LESS 50)
                message(FATAL_ERROR "${mode}: deadline fired before its configured 50 ms wait")
            endif()
            if(NOT "${output}\n${errors}" MATCHES "Shutdown wait timed out after [0-9]+ ms.*limit=50 ms.*pending=${pending}.*phase=${phase}.*process and resources are retained")
                message(FATAL_ERROR "${mode}: missing timeout wait/pending/phase/retention diagnostic\n${output}\n${errors}")
            endif()
        elseif(mode STREQUAL "update_throw_unknown")
            if(NOT "${output}\n${errors}" MATCHES "Shutdown update failed with an unknown exception; process and resources are retained")
                message(FATAL_ERROR "Unknown drain update exception lost its retained failure diagnostic")
            endif()
        elseif(mode STREQUAL "update_throw")
            if(NOT "${output}\n${errors}" MATCHES "Shutdown update failed: test drain update exception; process and resources are retained")
                message(FATAL_ERROR "Drain update exception lost its retained failure diagnostic")
            endif()
        elseif(mode STREQUAL "pre_shut_false" AND "shut" IN_LIST events)
            message(FATAL_ERROR "pre_shut failure incorrectly entered shut")
        endif()
        if(mode MATCHES "^stop_accepting_")
            set(failed_phase stop_accepting)
        elseif(mode STREQUAL "pre_shut_false")
            set(failed_phase pre_shut)
        elseif(mode MATCHES "^ready_throw")
            set(failed_phase ready_to_shut)
        else()
            set(failed_phase shut)
        endif()
        if(NOT mode MATCHES "^timeout_" AND NOT mode MATCHES "^update_throw" AND NOT "${output}\n${errors}" MATCHES "${failed_phase}: business-runtime-probe")
            message(FATAL_ERROR "${mode}: diagnostic must identify the failed module and phase")
        endif()
        string(REGEX MATCHALL "Shutdown (failed at |wait timed out |update failed)" diagnostics "${output}\n${errors}")
        list(LENGTH diagnostics count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "${mode}: expected one retained-resource diagnostic, got ${count}\n${output}\n${errors}")
        endif()
        if(mode STREQUAL "shut_throw" AND NOT "${output}\n${errors}" MATCHES "test shutdown exception")
            message(FATAL_ERROR "Throwing shutdown lost its exception diagnostic")
        endif()
        if(mode STREQUAL "stop_accepting_throw" AND NOT "${output}\n${errors}" MATCHES "test stop-accepting exception")
            message(FATAL_ERROR "Admission failure lost its standard exception diagnostic")
        endif()
        if(mode STREQUAL "stop_accepting_throw_unknown" AND NOT "${output}\n${errors}" MATCHES "stop_accepting: business-runtime-probe with an unknown exception")
            message(FATAL_ERROR "Admission failure lost its unknown exception diagnostic")
        endif()
        if(mode STREQUAL "ready_throw" AND NOT "${output}\n${errors}" MATCHES "test readiness exception")
            message(FATAL_ERROR "Readiness failure lost its standard exception diagnostic")
        endif()
        if(mode STREQUAL "ready_throw_unknown" AND NOT "${output}\n${errors}" MATCHES "ready_to_shut: business-runtime-probe with an unknown exception")
            message(FATAL_ERROR "Readiness failure lost its unknown exception diagnostic")
        endif()
        message(STATUS "${mode}: failure diagnosed once; process/resources retained until owned test timeout (not successful shutdown)")
    endif()
endforeach()

# Reject malformed, negative and out-of-range deadlines before loading a plugin.
foreach(value -1 invalid 50ms 9223372036854775808)
    execute_process(COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=invalid-deadline
        --app_conf=must-not-load.toml "--shutdown_timeout_ms=${value}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    if(NOT "${output}\n${errors}" MATCHES "Application parameter is invalid" OR "${output}\n${errors}" MATCHES "Application manifest loading failed")
        message(FATAL_ERROR "Invalid shutdown deadline ${value} was not rejected at argument parsing: ${result}\n${output}\n${errors}")
    endif()
endforeach()
