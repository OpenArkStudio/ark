foreach(mode capsule call-argument phase-record hook partial-wheel long-detail)
    execute_process(COMMAND "${PROGRAM}" "${mode}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    file(WRITE "${RUNTIME_DIR}-${mode}.stderr.log" "${errors}")
    if(NOT result STREQUAL "1" OR NOT errors MATCHES "Application startup failed")
        message(FATAL_ERROR "${mode}: persistent allocation failure did not exit1 with diagnostic: ${result}\n${errors}")
    endif()
    string(REGEX MATCHALL "released exactly once" releases "${errors}")
    list(LENGTH releases count)
    if(mode MATCHES "^(capsule|call-argument)$")
        if(NOT count EQUAL 0)
            message(FATAL_ERROR "${mode}: allocation failure before startup ran a cleanup")
        endif()
    elseif(NOT count EQUAL 1)
        message(FATAL_ERROR "${mode}: missing single cleanup under persistent allocation failure\n${errors}")
    endif()
    if(mode STREQUAL "call-argument" AND NOT errors MATCHES "cleanup: unsafe; owners retained")
        message(FATAL_ERROR "Pre-entry failure did not retain the enrolled owner\n${errors}")
    endif()
    if(mode MATCHES "^(hook|partial-wheel)$" AND NOT errors MATCHES "init: allocation-wheel")
        message(FATAL_ERROR "${mode}: phase/owner was lost\n${errors}")
    endif()
    string(LENGTH "${errors}" length)
    if(length GREATER 2048)
        message(FATAL_ERROR "Failure diagnostic exceeded its bound")
    endif()
    message(STATUS "${mode}: persistent allocation failure retained native diagnostic and exit1")
endforeach()
