foreach(argument PROGRAM PLUGIN_DIR SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUNTIME_DIR}")
file(TO_CMAKE_PATH "${PLUGIN_DIR}" directory)
string(APPEND directory "/")
string(REPLACE "\\" "\\\\" directory "${directory}")
string(REPLACE "\"" "\\\"" directory "${directory}")
foreach(mode throw:before_acquire throw:partial_acquire throw:after_acquire throw:install
    false:init false:post_init false:check_config false:pre_update
    throw:init throw:post_init throw:check_config throw:pre_update unsafe:init cleanup_throw:init)
    string(REPLACE ":" "-" stem "${mode}")
    set(manifest "${RUNTIME_DIR}/${stem}.toml")
    file(WRITE "${manifest}" "[application]\nplugin_library_dir = \"${directory}\"\n[[plugins]]\nname = \"ark_app_startup_cleanup_plugin\"\nconfig = \"${mode}\"\n")
    execute_process(COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=startup-cleanup-test
        "--app_conf=${manifest}"
        WORKING_DIRECTORY "${RUNTIME_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    file(WRITE "${manifest}.stdout.log" "${output}")
    file(WRITE "${manifest}.stderr.log" "${errors}")
    file(WRITE "${manifest}.result.txt" "${result}\n")
    if(NOT result STREQUAL "1" OR NOT errors MATCHES "Application startup failed")
        message(FATAL_ERROR "${mode}: expected diagnostic and exit1: ${result}\n${errors}")
    endif()
    if(errors MATCHES "forbidden_")
        message(FATAL_ERROR "${mode}: normal shutdown/destructor/uninstall/update ran\n${errors}")
    endif()
    string(REGEX MATCHALL "startup-cleanup:release_enter" entries "${errors}")
    list(LENGTH entries count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${mode}: expected exactly one resource release\n${errors}")
    endif()
    if(mode MATCHES "^(unsafe|cleanup_throw):")
        if(errors MATCHES "startup-cleanup:release_done")
            message(FATAL_ERROR "${mode}: cleanup incorrectly reported complete")
        endif()
    elseif(NOT errors MATCHES "startup-cleanup:release_done")
        message(FATAL_ERROR "${mode}: private wheel cleanup did not complete\n${errors}")
    endif()
    if(mode STREQUAL "unsafe:init")
        set(cleanup_result "unsafe")
    elseif(mode STREQUAL "cleanup_throw:init")
        set(cleanup_result "failed")
    else()
        set(cleanup_result "done")
    endif()
    if(NOT errors MATCHES "Startup failure cleanup: ${cleanup_result}")
        message(FATAL_ERROR "${mode}: framework cleanup result lost\n${errors}")
    endif()
    string(FIND "${errors}" "Application startup failed" primary_position)
    string(FIND "${errors}" "startup-cleanup:release_enter" cleanup_position)
    if(NOT primary_position LESS cleanup_position)
        message(FATAL_ERROR "${mode}: primary failure must precede cleanup")
    endif()
    set(expected "")
    if(NOT mode MATCHES "^throw:(before_acquire|partial_acquire)$")
        list(APPEND expected "startup-cleanup:acquired")
    endif()
    if(mode MATCHES ":(init|post_init|check_config|pre_update)$")
        string(REPLACE ":" ";" pieces "${mode}")
        list(GET pieces 1 failed_phase)
        foreach(phase init post_init check_config pre_update)
            list(APPEND expected "startup-cleanup:${phase}")
            if(phase STREQUAL failed_phase)
                break()
            endif()
        endforeach()
    endif()
    list(APPEND expected "startup-cleanup:release_enter")
    if(NOT mode MATCHES "^(unsafe|cleanup_throw):")
        list(APPEND expected "startup-cleanup:release_done")
    endif()
    string(REGEX MATCHALL "startup-cleanup:[a-z_]+" observed "${errors}")
    if(NOT "${observed}" STREQUAL "${expected}")
        message(FATAL_ERROR "${mode}: later/repeated phase or unexpected resource order\nexpected=${expected}\nobserved=${observed}\n${errors}")
    endif()
    message(STATUS "${mode}: actual launcher/DSO independent capsule cleanup once, exit1, no normal teardown")
endforeach()

foreach(outcome done unsafe failed throw)
    set(manifest "${RUNTIME_DIR}/multi-${outcome}.toml")
    file(WRITE "${manifest}" "[application]\nplugin_library_dir = \"${directory}\"\n[[plugins]]\nname = \"ark_app_startup_cleanup_plugin\"\nconfig = \"multi:${outcome}\"\n")
    execute_process(COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=startup-cleanup-test
        "--app_conf=${manifest}"
        WORKING_DIRECTORY "${RUNTIME_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    file(WRITE "${manifest}.stdout.log" "${output}")
    file(WRITE "${manifest}.stderr.log" "${errors}")
    file(WRITE "${manifest}.result.txt" "${result}\n")
    if(NOT result STREQUAL "1" OR NOT errors MATCHES "Application startup failed" OR errors MATCHES "forbidden_")
        message(FATAL_ERROR "multi:${outcome}: expected exit1, retained owners/code and primary failure\n${errors}")
    endif()
    string(REGEX MATCHALL "startup-cleanup:(older|middle|newer)" observed "${errors}")
    set(expected "startup-cleanup:newer;startup-cleanup:middle")
    set(cleanup_result "${outcome}")
    if(outcome STREQUAL "done")
        list(APPEND expected "startup-cleanup:older")
    elseif(outcome STREQUAL "throw")
        set(cleanup_result "failed")
    endif()
    if(NOT "${observed}" STREQUAL "${expected}" OR
        NOT errors MATCHES "Startup failure cleanup: ${cleanup_result}")
        message(FATAL_ERROR "multi:${outcome}: reverse order/early halt/result lost\n${errors}")
    endif()
    string(FIND "${errors}" "Application startup failed" primary_position)
    string(FIND "${errors}" "startup-cleanup:release_enter" cleanup_position)
    if(NOT primary_position LESS cleanup_position)
        message(FATAL_ERROR "multi:${outcome}: primary failure must precede cleanup")
    endif()
    message(STATUS "multi:${outcome}: actual launcher/three-module DSO reverse cleanup and retained exit1")
endforeach()
