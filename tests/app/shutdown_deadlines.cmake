cmake_minimum_required(VERSION 3.20)
foreach(argument PROGRAM PLUGIN_DIR SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
file(TO_CMAKE_PATH "${PLUGIN_DIR}" plugin_directory)
set(modes boundary_admission boundary_readiness boundary_pre_shut)
if(DEFINED MODE)
    set(modes "${MODE}")
endif()
foreach(mode IN LISTS modes)
    set(directory "${RUNTIME_DIR}/${mode}")
    file(MAKE_DIRECTORY "${directory}")
    file(REMOVE "${directory}/business-runtime.trace")
    file(WRITE "${directory}/exit.txt" "exit\n")
    file(WRITE "${directory}/application.toml"
        "[application]\nplugin_library_dir = '${plugin_directory}/'\nplugin_config_dir = './'\n"
        "[[plugins]]\nname = 'ark_business_runtime_probe'\nconfig = '${mode}'\n")
    execute_process(
        COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=shutdown-deadline-test
            "--app_conf=${directory}/application.toml"
             --shutdown_timeout_ms=50
        WORKING_DIRECTORY "${directory}" INPUT_FILE "${directory}/exit.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
    file(WRITE "${directory}/output.log" "${output}\n${errors}")
    file(WRITE "${directory}/result.txt" "${result}\n")
    if(NOT EXISTS "${directory}/business-runtime.trace")
        message(FATAL_ERROR "${mode}: test plugin did not run: ${result}\n${output}\n${errors}")
    endif()
    file(STRINGS "${directory}/business-runtime.trace" events)
    if(mode STREQUAL "boundary_admission")
        set(expected request-stop stop-accepting admission-return)
        set(forbidden ready ready-return pre-shut pre-shut-return)
        set(phase stop_accepting)
    elseif(mode STREQUAL "boundary_readiness")
        set(expected request-stop stop-accepting admission-return ready ready-return)
        set(forbidden pre-shut pre-shut-return)
        set(phase ready_to_shut)
    else()
        set(expected request-stop stop-accepting admission-return ready ready-return pre-shut pre-shut-return)
        set(forbidden)
        set(phase pre_shut)
    endif()
    set(previous -1)
    foreach(event IN LISTS expected)
        list(FIND events "${event}" current)
        set(occurrences "${events}")
        list(FILTER occurrences INCLUDE REGEX "^${event}$")
        list(LENGTH occurrences count)
        if(current LESS_EQUAL previous OR NOT count EQUAL 1)
            message(FATAL_ERROR "${mode}: missing/repeated/out-of-order ${event}: ${events}")
        endif()
        set(previous ${current})
    endforeach()
    list(APPEND forbidden shut uninstall destroy update-after-cleanup)
    foreach(event IN LISTS forbidden)
        if("${event}" IN_LIST events)
            message(FATAL_ERROR "${mode}: deadline crossed into ${event}: ${events}; result=${result}")
        endif()
    endforeach()
    if(NOT "${result}" MATCHES "[Tt]imeout")
        message(FATAL_ERROR "${mode}: expected retained process, got ${result}: ${events}")
    endif()
    string(REGEX MATCHALL "Shutdown (failed at |wait timed out |update failed)" diagnostics "${output}\n${errors}")
    list(LENGTH diagnostics count)
    if(NOT count EQUAL 1 OR NOT "${output}\n${errors}" MATCHES
        "Shutdown wait timed out after [0-9]+ ms.*limit=50 ms.*pending=0.*phase=${phase}.*process and resources are retained")
        message(FATAL_ERROR "${mode}: expected one phase-specific timeout diagnostic\n${output}\n${errors}")
    endif()
    message(STATUS "${mode}: successful slow hook returned; no later cleanup or successful exit")
endforeach()
