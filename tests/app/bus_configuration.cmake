foreach(argument PROGRAM PLUGIN_DIR SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUNTIME_DIR}")
file(TO_CMAKE_PATH "${PLUGIN_DIR}" plugin_directory)
file(TO_CMAKE_PATH "${RUNTIME_DIR}" configuration_directory)
file(READ "${SOURCE_ROOT}/config/bus.plugin.toml" valid_configuration)
foreach(mode invalid_threads invalid_intranet unknown_setting xml_content missing_file)
    set(configuration "${valid_configuration}")
    set(expected "threads")
    if(mode STREQUAL "invalid_threads")
        string(REPLACE "threads = 2" "threads = 256" configuration "${configuration}")
    elseif(mode STREQUAL "invalid_intranet")
        string(REPLACE "tcp://127.0.0.1:9011" "tcp://localhost:65536" configuration "${configuration}")
        set(expected intranet_endpoint)
    elseif(mode STREQUAL "unknown_setting")
        string(REPLACE "[bus]" "[bus]\nunknown_setting = 1" configuration "${configuration}")
        set(expected unknown_setting)
    elseif(mode STREQUAL "xml_content")
        set(configuration "<xml><applications/></xml>")
        set(expected "cannot parse TOML")
    elseif(mode STREQUAL "missing_file")
        set(expected "could not open configuration")
    endif()
    set(path "${configuration_directory}/${mode}.toml")
    if(NOT mode STREQUAL "missing_file")
        file(WRITE "${path}" "${configuration}")
    else()
        file(REMOVE "${path}")
    endif()
    set(manifest "${RUNTIME_DIR}/${mode}.app.toml")
    file(WRITE "${manifest}" "[application]\nplugin_library_dir = '${plugin_directory}/'\n"
        "[[plugins]]\nname = 'ark_bus_plugin'\nconfig = '${path}'\n"
        "[[plugins]]\nname = 'ark_net_plugin'\n[[plugins]]\nname = 'ark_utility_plugin'\n")
    execute_process(COMMAND "${PROGRAM}" --busid=1.0.1.1 --name=bus-config-test
        "--app_conf=${manifest}"
        WORKING_DIRECTORY "${RUNTIME_DIR}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    file(WRITE "${manifest}.stdout.log" "${output}")
    file(WRITE "${manifest}.stderr.log" "${errors}")
    if(NOT result STREQUAL "1")
        message(FATAL_ERROR "${mode}: expected normal exit 1, got ${result}\n${output}\n${errors}")
    endif()
    if(NOT errors MATCHES "Application startup failed at init:" OR NOT errors MATCHES "bus_module" OR
        NOT errors MATCHES "${expected}")
        message(FATAL_ERROR "${mode}: missing module/field diagnostic\n${errors}")
    endif()
    message(STATUS "${mode}: normal exit 1 with Bus initialization diagnostic")
endforeach()
