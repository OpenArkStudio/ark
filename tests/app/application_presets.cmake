cmake_minimum_required(VERSION 3.20)
foreach(argument PROGRAM UTILITY_PLUGIN SAMPLE_PLUGIN SOURCE_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "${argument} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${RUNTIME_DIR}/bin" "${RUNTIME_DIR}/conf")
file(COPY "${PROGRAM}" "${UTILITY_PLUGIN}" "${SAMPLE_PLUGIN}" DESTINATION "${RUNTIME_DIR}/bin")
file(COPY "${SOURCE_ROOT}/config/timers.app.toml"
    DESTINATION "${RUNTIME_DIR}/conf")
get_filename_component(executable "${PROGRAM}" NAME)
file(WRITE "${RUNTIME_DIR}/exit.txt" "exit\n")
set(command "${RUNTIME_DIR}/bin/${executable}"
    --busid=1.0.1.1 --name=timers --app_conf=conf/timers.app.toml)
if(UNIX)
    list(PREPEND command sh "${SOURCE_ROOT}/tests/app/application_preset_stop.sh" "${RUNTIME_DIR}/output.pipe" 13)
endif()
execute_process(COMMAND ${command}
    WORKING_DIRECTORY "${RUNTIME_DIR}" INPUT_FILE "${RUNTIME_DIR}/exit.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
file(WRITE "${RUNTIME_DIR}/output.log" "${output}\n${errors}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Shipped Timers TOML preset must stop successfully: ${result}\n${output}\n${errors}")
endif()
set(previous -1)
foreach(event init PostInit PreShut Shut)
    string(REGEX MATCH "timers_module[^\r\n]*, ${event}" matched "${output}\n${errors}")
    if(matched STREQUAL "")
        message(FATAL_ERROR "Missing lifecycle event ${event}\n${output}\n${errors}")
    endif()
    string(FIND "${output}\n${errors}" "${matched}" current)
    if(current LESS_EQUAL previous)
        message(FATAL_ERROR "Missing/out-of-order lifecycle event ${event}\n${output}\n${errors}")
    endif()
    set(previous ${current})
endforeach()
message(STATUS "Shipped Timers TOML preset: real Utility/Timers DSOs initialize and shut down in a runtime path with spaces, exit 0")
