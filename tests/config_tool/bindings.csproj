<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="bindings.cs" />
    <Compile Include="$(GeneratedFields)" Link="EntityFields.cs" />
  </ItemGroup>
  <Target Name="RequireGeneratedFields" BeforeTargets="CoreCompile">
    <Error Condition="'$(GeneratedFields)' == ''" Text="Set GeneratedFields to the exported code/EntityFields.cs path." />
  </Target>
</Project>
