foreach(required ARK_SOURCE_DIR PROTOC TEST_BINARY_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
foreach(branch windows native)
    set(test_win32 OFF)
    if(branch STREQUAL "windows")
        set(test_win32 ON)
    endif()
    set(build "${TEST_BINARY_DIR}/${branch}-ninja")
    execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja -S "${ARK_SOURCE_DIR}/tests/proto/configuration" -B "${build}"
        "-DARK_SOURCE_DIR=${ARK_SOURCE_DIR}" "-DPROTOC=${PROTOC}" "-DTEST_WIN32=${test_win32}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${branch} protocol configuration failed: ${result}\n${output}\n${errors}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target generate-protocol-contract --parallel 1
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "${branch} protocol generation failed: ${result}\n${output}\n${errors}")
    endif()
    file(READ "${build}/proto/generated/ark/proto/entity_messages.pb.h" generated)
    file(READ "${build}/consumer-definitions.txt" consumer)
    if(test_win32)
        if(NOT generated MATCHES "class ARK_PROTO_EXPORT protobuf_entity_data" OR
                NOT consumer MATCHES "ARK_PROTO_EXPORT=__declspec\\(dllimport\\)" OR
                consumer MATCHES "dllexport")
            message(FATAL_ERROR "Windows generated message/descriptor exports or transitive consumer imports missing")
        endif()
        if(generated MATCHES "DescriptorTable descriptor_table_entity_5fmessages_2eproto" AND
                NOT generated MATCHES "(ARK_PROTO_EXPORT extern|extern ARK_PROTO_EXPORT) const ::google::protobuf::internal::DescriptorTable descriptor_table_entity_5fmessages_2eproto")
            message(FATAL_ERROR "Generated descriptor table is missing its DLL export declaration")
        endif()
    elseif(generated MATCHES "ARK_PROTO_EXPORT" OR consumer MATCHES "ARK_PROTO_EXPORT")
        message(FATAL_ERROR "Legacy generator invocation unexpectedly added DLL export declarations")
    endif()
endforeach()
message(STATUS "Protocol target configuration and real protoc export/native generation passed; no Windows binaries were compiled")
