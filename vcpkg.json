{
  "name": "ark",
  "version": "1.0.0",
  "description": "C++20 distributed plugin framework",
  "license": "Apache-2.0",
  "builtin-baseline": "0699a19d0c6386247ce50d4dedbb8217d484d536",
  "dependencies": [
    "asio",
    "rapidxml",
    "spdlog",
    "readerwriterqueue"
  ],
  "features": {
    "compression-tests": {
      "description": "Build focused compression regression tests",
      "dependencies": [
        "lz4",
        "zlib",
        "zstd"
      ]
    },
    "database": {
      "description": "Build native database development tests with OpenSSL authentication and TLS",
      "dependencies": [
        "openssl"
      ]
    },
    "boost": {
      "description": "Use Boost.Asio and Boost.Beast",
      "dependencies": [
        "boost-asio",
        "boost-beast"
      ]
    },
    "application": {
      "description": "Build ARK applications and plugins",
      "dependencies": [
        "nlohmann-json",
        "protobuf",
        "zlib",
        "zstd",
        "args"
      ]
    },
    "config": {
      "description": "Build the TOML/XML application manifest reader",
      "dependencies": [
        "tomlplusplus"
      ]
    },
    "guest-room": {
      "description": "Build the optional guest-room JSON client/server example",
      "dependencies": [
        "nlohmann-json"
      ]
    },
    "etcd-client": {
      "description": "Build the optional etcd client plugin",
      "dependencies": [
        "nlohmann-json"
      ]
    }
  },
  "default-features": [
    "boost",
    "config"
  ]
}
